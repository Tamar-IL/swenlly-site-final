# ── swenlly site — environment variables ──
# The site is fully browsable without any of these. Forms/agent degrade gracefully.

# LLM (visitor agent). Default provider: anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# Airtable (leads / bookings / agent transcripts) — OPTIONAL.
# Leave blank to deliver leads by email only. Nothing is lost: if neither
# Airtable nor email accepts a lead, the form tells the visitor it failed
# rather than pretending it went through.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Resend (email notifications). With Airtable blank this is the ONLY place
# leads go, so it has to work. Two requirements:
#   1. The variable name needs underscores — RESEND_API_KEY, not RESEND-API-KEY.
#   2. The sending domain in lib/resend.ts (swenlly.com) must be verified in
#      Resend, or every send is rejected.
# Check both at once on a running container:  curl -s https://swenlly.com/api/health
RESEND_API_KEY=
NOTIFY_EMAIL=info@swenlly.com

# Cloudflare Turnstile (anti-bot). If unset, verification is skipped (dev).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Site
SITE_URL=https://swenlly.com

# Holding page: set to true to park every page on /soon.
# Toggle and restart the container — no rebuild needed.
COMING_SOON=false
