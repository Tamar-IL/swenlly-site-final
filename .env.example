# ── swenlly site — environment variables ──
# The site is fully browsable without any of these. Forms/agent degrade gracefully.

# LLM (visitor agent). Default provider: anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# Airtable (leads / bookings / agent transcripts)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Resend (email notifications)
RESEND_API_KEY=
NOTIFY_EMAIL=info@swenlly.com

# Cloudflare Turnstile (anti-bot). If unset, verification is skipped (dev).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Site
SITE_URL=https://swenlly.com
