# ── swenlly site — environment variables ──
# The site is fully browsable without any of these. Forms/agent degrade gracefully.

# LLM (visitor agent). Default provider: anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# Airtable (leads / agent transcripts) — OPTIONAL, and not used by the booking
# calendar at all: meetings live in data/bookings.json on the container's volume.
# Leave these blank to deliver leads by email only. Nothing is lost: if neither
# Airtable nor email accepts a lead, the form tells the visitor it failed rather
# than pretending it went through.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Resend (email notifications). With Airtable blank this is the ONLY place
# leads go, so it has to work. Two requirements:
#   1. The variable name needs underscores — RESEND_API_KEY, not RESEND-API-KEY.
#   2. The sending domain in lib/resend.ts (swenlly.com) must be verified in
#      Resend, or every send is rejected.
# Check both at once on a running container:  curl -s https://swenlly.com/api/health
RESEND_API_KEY=
NOTIFY_EMAIL=info@swenlly.com

# Cloudflare Turnstile (anti-bot). If unset, verification is skipped (dev).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Google Meet links. OPTIONAL — without these a meeting is still booked and
# confirmed, the email just carries no call link.
#
# These are an OAuth refresh token for the Google account whose calendar holds
# the meetings, NOT a service-account key: a service account can only create Meet
# links by impersonating a real user through domain-wide delegation, which needs
# Google Workspace and an admin. A refresh token works on a plain Gmail account.
#
# Setup, once (full walkthrough with both routes in DEPLOY.md → "Google Meet links"):
#   1. https://console.cloud.google.com → create or pick a project.
#   2. APIs & Services → Library → enable "Google Calendar API".
#   3. Publish the app: APIs & Services → OAuth consent screen (this opens
#      "Google Auth Platform") → Audience → PUBLISH APP.
#      A Testing app rejects every account that is not a listed test user with
#      "403: access_denied ... האפליקציה נמצאת כרגע בבדיקה", and even a listed
#      one gets a refresh token Google expires after 7 DAYS. Publishing needs no
#      verification review — it only shows an "unverified app" warning to
#      whoever authorises it (Advanced → Go to ... (unsafe)).
#   4. Credentials → Create credentials → OAuth client ID, then either:
#        • Web application, redirect URI
#          https://developers.google.com/oauthplayground
#          → get the token in the browser, no terminal (DEPLOY.md, Route A); or
#        • Desktop app → cd into this repo and run `npm run google:token`,
#          which prints all four lines (DEPLOY.md, Route B).
# Scope requested: calendar.events only — it cannot read anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar the meetings land in. "primary" is that account's own calendar.
GOOGLE_CALENDAR_ID=primary

# Reminders. The server sweeps for meetings starting in about an hour every few
# minutes on its own, so nothing here is required. Set CRON_SECRET only if you
# also want to drive the sweep from an external scheduler:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://swenlly.com/api/cron/reminders
# With it unset the endpoint is open, so either set it or leave the endpoint
# unused. A booking is only ever reminded once, whoever triggers the sweep.
CRON_SECRET=

# Where booked meetings are stored. Defaults to <app>/data/bookings.json, which
# docker-compose keeps on a named volume so it survives a rebuild. This file IS
# the record: losing it reopens booked slots, drops pending reminders and breaks
# the cancel/reschedule links already sitting in people's inboxes.
# BOOKINGS_FILE=/app/data/bookings.json
# How long a past meeting is kept before it is pruned (the privacy policy says
# up to three years).
# BOOKING_RETENTION_DAYS=1095

# Site. Also the base for the cancel/reschedule links in the emails, so it has
# to be the real public address.
SITE_URL=https://swenlly.com

# Holding page: set to true to park every page on /soon.
# Toggle and restart the container — no rebuild needed.
COMING_SOON=false
